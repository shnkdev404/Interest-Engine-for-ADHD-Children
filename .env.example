# Copy to .env.local and fill in. Never commit real keys.

# Qloo hackathon API — keys only work on this base URL
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=
# live | mock. Default: live when QLOO_API_KEY is set, else mock (hand-written catalog, lib/qloo/mock.ts)
QLOO_MODE=

ANTHROPIC_API_KEY=

# Signs the session cookie. Required in production; any long random string.
SESSION_SECRET=

# Hindsight memory. Unset = local fallback memory in Postgres (lib/memory)
HINDSIGHT_URL=
HINDSIGHT_API_KEY=

# Postgres (Neon). Unset = embedded local Postgres (PGlite) in .data/pglite
DATABASE_URL=
