{
  "name": "sparkpath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "qloo:coverage": "tsx --env-file-if-exists=.env.local scripts/qloo-coverage-test.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "plan": "tsx --env-file-if-exists=.env.local scripts/plan.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "vercel-build": "tsx scripts/migrate.ts && next build --turbopack",
    "demo:prewarm": "tsx --env-file-if-exists=.env.local scripts/prewarm.ts",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@electric-sql/pglite": "^0.5.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@vectorize-io/hindsight-client": "^1.0.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.57.0",
    "next": "15.5.28",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
